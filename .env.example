# Supabase project → Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server only, never ship to the browser

PORT=3000

# Which deployment this is. Anything other than `production` marks the app as a
# TEST deployment: the three PWAs are served with a "TEST " name and a crimson
# theme colour so the installed icon can't be confused with the real one, the
# page title gains a TEST prefix, and each service worker's cache name gets the
# app's content hash appended so every deploy invalidates its own cache (no more
# hand-bumping CACHE in sw.js to see a change on your phone).
#
# LEAVE THIS UNSET IN PRODUCTION. Unset means production, so a misconfigured
# environment fails toward "treat me as live" rather than the other way round.
# The staging Heroku app sets APP_ENV=staging; so does local dev.
# APP_ENV=staging

# Public origin, used to build the punch-card QR links. Set it wherever the
# browser-visible origin isn't what the dyno sees (i.e. behind Cloudflare);
# otherwise the request's own host is correct.
# APP_ORIGIN=https://we-rewards.com

# Operator dashboard at /admin — comma-separated emails allowed to see analytics
# + error logs. Must match the Google account you sign in with. Leave blank to
# lock everyone out of /admin.
ADMIN_EMAILS=you@example.com

# Trusted-proxy hop count for correct client IPs / rate limiting. Default 1 (one
# PaaS proxy). Set to 2 behind e.g. Cloudflare→Render, or false with no proxy.
# TRUST_PROXY=1

# Web-push keys, shared by the admin "new vendor application" alerts and student
# deal notifications. Generate once with: npx web-push generate-vapid-keys
# Leave blank to disable push silently (the rest of the app is unaffected —
# campaigns still queue and still show in every student's in-app Deals list).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Vendor deals: the anti-storm fences (migration-032) ----
# Defaults are the pilot's and are documented in the Privacy Policy (§7.4), so
# loosening the caps means revising that document and bumping TERMS_VERSION.
# Every value below is optional; the shipped defaults are shown.
#
# CAMPAIGN_COOLDOWN_MINUTES=240      # hard floor between two notifications to one student
# CAMPAIGN_DAILY_CAP=2               # ...per rolling day
# CAMPAIGN_WEEKLY_CAP=5              # ...per rolling week
# CAMPAIGN_COALESCE_MINUTES=5        # hold before release; 0 disables bundling entirely
# CAMPAIGN_VENDOR_COOLDOWN_HOURS=20  # one vendor to one student
# CAMPAIGN_VENDOR_WEEKLY_SENDS=2     # sends a vendor gets per rolling week
# CAMPAIGN_BUNDLE_MAX=4              # vendors named in one digest
# CAMPAIGN_QUIET_START=22            # campus-local quiet hours [start, end)
# CAMPAIGN_QUIET_END=9               # set both to the same value to disable
# CAMPAIGN_TIMEZONE=America/New_York # falls back to PUNCH_TIMEZONE
# CAMPAIGN_DURATION_HOURS=48         # default life of a deal
# CAMPAIGN_TICK_SECONDS=30           # delivery worker interval
# CAMPAIGN_BATCH_USERS=40            # students settled per tick

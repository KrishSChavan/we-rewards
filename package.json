{
  "name": "psu-rewards",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "_comment:test-concurrency": "--test-concurrency=1 in the test scripts is load-bearing, not tuning. node --test runs test FILES in parallel processes, and every file importing ../server.js runs buildClientAssets() at import, which rm -rf's and rewrites .build/. Two of those at once is ENOTEMPTY on Windows. Two files import it today: content-type.test.js and not-found.test.js. Same race scripts/_deploy-lib.ps1 sidesteps by running check-client.js instead of the real build, and the same reason a running `npm run dev` must be stopped before a deploy.",
  "scripts": {
    "dev": "node --watch server.js",
    "nodemon": "nodemon server.js",
    "start": "node server.js",
    "onboard": "node scripts/onboard-vendor.js",
    "deploy:staging": "node scripts/run-ps.mjs scripts/deploy-staging.ps1",
    "deploy:prod": "node scripts/run-ps.mjs scripts/promote-to-main.ps1",
    "ship": "node scripts/run-ps.mjs scripts/ship.ps1",
    "ship:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ship.ps1",
    "ship:mac": "pwsh -NoProfile -File scripts/ship.ps1",
    "check:gemini": "node scripts/check-gemini.js",
    "check:client": "node scripts/check-client.js",
    "check:resend": "node scripts/check-resend.js",
    "check:posthog": "node scripts/check-posthog.js",
    "test": "node --import ./test/setup.js --test --test-concurrency=1 test/*.test.js test/integration/*.test.js",
    "test:unit": "node --import ./test/setup.js --test --test-concurrency=1 test/*.test.js",
    "test:integration": "node --import ./test/setup.js --test --test-concurrency=1 test/integration/*.test.js",
    "test:sql": "node scripts/run-ps.mjs test/sql/run.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jose": "^6.2.8",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "qrcode-generator": "^2.0.4",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7"
  },
  "description": "Per-vendor points rewards for local eateries. Student PWA + vendor terminal, one Express app.",
  "main": "server.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "directories": {
    "test": "test"
  }
}
